import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

const products = [
  { id: 1, name: "Молоко", price: 50, image: "https://via.placeholder.com/150" },
  { id: 2, name: "Хлеб", price: 20, image: "https://via.placeholder.com/150" },
  { id: 3, name: "Яблоки", price: 80, image: "https://via.placeholder.com/150" }
];

export default function Supermarket() {
  const [cart, setCart] = useState([]);

  const addToCart = (product) => {
    setCart([...cart, product]);
  };

  return (
    <div className="p-4 max-w-4xl mx-auto">
      <h1 className="text-3xl font-bold mb-4">Супермаркет</h1>
      <div className="grid grid-cols-3 gap-4">
        {products.map((product) => (
          <Card key={product.id} className="p-4">
            <CardContent>
              <img src={product.image} alt={product.name} className="w-full mb-2" />
              <h2 className="text-xl font-semibold">{product.name}</h2>
              <p className="text-gray-600">{product.price} сом</p>
              <Button onClick={() => addToCart(product)} className="mt-2 w-full">
                Добавить в корзину
              </Button>
            </CardContent>
          </Card>
        ))}
      </div>
      <div className="mt-6 p-4 border rounded-lg">
        <h2 className="text-2xl font-semibold">Корзина</h2>
        {cart.length === 0 ? (
          <p>Корзина пуста</p>
        ) : (
          <ul>
            {cart.map((item, index) => (
              <li key={index}>{item.name} - {item.price} сом</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  );
}
